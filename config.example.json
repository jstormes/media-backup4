{
  "media_path": "/srv/media-backup",
  "finished_path": null,
  "cancelled_path": null,

  "makemkvcon": "/usr/local/bin/makemkvcon",
  "cache_mb": 1024,
  "decrypt": true,
  "use_stdbuf": true,

  "max_concurrent_jobs": 0,
  "min_free_margin_bytes": 10737418240,
  "size_ratio_floor": 0.90,
  "stall_timeout_s": 1800,
  "max_job_duration_s": 21600,

  "feature_ratio": 0.90,
  "min_feature_seconds": 600,
  "max_feature_titles": 5,

  "eject_on_success": true,
  "keep_rejected_attempts": 1,
  "max_log_bytes": 52428800
}
